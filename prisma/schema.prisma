// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/modules/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ClientMods {
  Aliucord
  BetterDiscord
  Replugged
  Vencord
}

model User {
  id     String  @id // Discord Snowflake
  badges Badge[]
}

model Badge {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  clientMod ClientMods
  name      String?
  image     String? // External image URL for custom badges; null for built-in badges

  @@index([userId])
  @@index([clientMod])
}
