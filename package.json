{
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" && prettier --check .",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix && prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:debug": "vitest --project unit --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --project e2e"
  },
  "imports": {
    "#config": {
      "source": "./src/modules/appconfig/appconfig.service.ts",
      "default": "./dist/modules/appconfig/appconfig.service.js"
    },
    "#modules/*": {
      "source": "./src/modules/*",
      "default": "./dist/modules/*"
    },
    "#problems/dto": {
      "source": "./src/problems/dto/index.ts",
      "default": "./dist/problems/dto/index.js"
    },
    "#problems/exception": {
      "source": "./src/problems/exception/index.ts",
      "default": "./dist/problems/exception/index.js"
    },
    "#problems/filter": {
      "source": "./src/problems/filter/index.ts",
      "default": "./dist/problems/filter/index.js"
    },
    "#problems/response": {
      "source": "./src/problems/response/index.ts",
      "default": "./dist/problems/response/index.js"
    },
    "#providers/*": {
      "source": "./src/providers/*",
      "default": "./dist/providers/*"
    },
    "#utils": {
      "source": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino-http-print": "^4.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
